{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "nodenext",
    "esModuleInterop": true,
    "allowJs": true,
    "moduleResolution": "nodenext",
    "listEmittedFiles": true,
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "isolatedModules": true,
    "types": ["node", "jest"],
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "rootDir": ".",
    "outDir": "dist/"
  },
  "ts-node": {
    "files": true
  }
}
