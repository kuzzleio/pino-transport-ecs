{
  "name": "pino-transport-ecs",
  "version": "1.0.1",
  "description": "A Pino transform transport that converts logs to the Elastic Common Schema format, using the official formatters from Elastic.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc --build tsconfig.build.json",
    "prepack": "npm run build",
    "dev": "NODE_ENV=development ergol tests/application/app.ts -c ergol.config.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "test": "npm run test:types && npm run test:unit",
    "test:unit": "jest --runInBand",
    "test:types": "tsc -p tsconfig.build.json --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@elastic/ecs-pino-format": "^1.5.0",
    "pino-abstract-transport": "^2.0.0",
    "serialize-error": "^8.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/lint-staged": "^13.3.0",
    "@types/node": "^22.13.5",
    "cz-conventional-changelog": "^3.3.0",
    "ergol": "^1.0.2",
    "eslint": "^9.21.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-kuzzle": "^1.0.0-eslint-9.6",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.4.3",
    "pino": "^9.6.0",
    "prettier": "^3.5.2",
    "rimraf": "^6.0.1",
    "semantic-release-config-kuzzle": "^1.1.2",
    "semantic-release-slack-bot": "^4.0.2",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.3"
  },
  "files": [
    "dist/"
  ]
}
