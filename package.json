{
  "name": "pino-transport-ecs",
  "version": "1.1.0",
  "description": "A Pino transform transport that converts logs to the Elastic Common Schema format, using the official formatters from Elastic.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc --build tsconfig.build.json",
    "prepack": "npm run build",
    "dev": "NODE_ENV=development ergol tests/application/app.ts -c ergol.config.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "test": "npm run test:types && npm run test:unit",
    "test:unit": "jest --runInBand",
    "test:types": "tsc -p tsconfig.build.json --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@elastic/ecs-pino-format": "^1.5.0",
    "pino-abstract-transport": "^2.0.0",
    "serialize-error": "^8.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/jest": "^30.0.0",
    "@types/lint-staged": "^13.3.0",
    "@types/node": "^24.19.2",
    "cz-conventional-changelog": "^3.3.0",
    "ergol": "^1.0.2",
    "eslint": "^10.14.0",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-kuzzle": "^2.0.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "pino": "^10.4.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "semantic-release-config-kuzzle": "1.8.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "files": [
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuzzleio/pino-transport-ecs.git"
  },
  "bugs": {
    "url": "https://github.com/kuzzleio/pino-transport-ecs/issues"
  },
  "homepage": "https://github.com/kuzzleio/pino-transport-ecs#readme"
}
